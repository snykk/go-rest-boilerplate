# Copy to .env for local development. Variables set in the process environment win over this file,
# and an empty value means "use the default".

# development or production.
APP_ENV=development
# The service's name in log records and traces.
SERVICE_NAME=go-rest-boilerplate

HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_BODY_LIMIT_BYTES=1048576
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For is trusted, e.g. 10.0.0.0/8.
HTTP_TRUSTED_PROXIES=
# Comma-separated origins; * in development, required in production.
HTTP_CORS_ALLOWED_ORIGINS=*

# debug, info, warn or error.
LOG_LEVEL=info
# text or json; defaults to text in development and json in production.
LOG_FORMAT=
# true or false: add the file and line of each logging call as source.
LOG_SOURCE=true
# true or false; defaults to true in development and false in production.
SWAGGER_ENABLED=

# OTLP/HTTP base URL of the collector traces and metrics are pushed to, such as http://localhost:4318;
# empty pushes none.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Share of new traces recorded, from 0 to 1; metrics are never sampled.
TRACING_SAMPLE_RATIO=1
# How often metrics are pushed.
METRICS_EXPORT_INTERVAL=60s
# Bearer token of the operator endpoints under /admin, at least 32 characters; empty leaves them off.
ADMIN_TOKEN=

DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# Mail: the SMTP server, the sender of every message, and the queue that sends in the background.
# localhost:1025 is Mailpit as seen from the host (docker compose -f deployment/compose.yml up mailpit; inbox at
# http://localhost:8025); the api container of that stack reaches it at mailpit:1025.
MAIL_SMTP_ADDR=localhost:1025
MAIL_FROM=no-reply@example.com
# PLAIN authentication when a username is set; it is only sent over STARTTLS or to the local host.
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
# true upgrades the connection with STARTTLS and fails when the server does not offer it.
MAIL_SMTP_STARTTLS=false
# The limit of one delivery as a whole.
MAIL_TIMEOUT=10s
# Messages held in memory before new ones are dropped.
MAIL_QUEUE_SIZE=100

# The article module: the page size of a list that asks for none, and the most a list returns.
ARTICLE_DEFAULT_PAGE_SIZE=20
ARTICLE_MAX_PAGE_SIZE=100

# The identity module. The JWT secret signs and verifies access tokens: at least 32 bytes, and in production a
# random value kept out of the repository, such as the output of `openssl rand -base64 32`. The value below is
# for local development only: the application refuses it when APP_ENV=production.
IDENTITY_JWT_SECRET=development-secret-32-bytes-long
IDENTITY_JWT_ISSUER=go-rest-boilerplate
IDENTITY_JWT_AUDIENCE=go-rest-boilerplate
# Lifetimes of access tokens, refresh tokens, verification codes and reset tokens; each at least 1m.
IDENTITY_ACCESS_TTL=15m
IDENTITY_REFRESH_TTL=720h
IDENTITY_CODE_TTL=10m
IDENTITY_RESET_TTL=30m
# How long after a refresh the spent token may come again, from a client that missed the answer, without
# being taken as stolen.
IDENTITY_REFRESH_REUSE_GRACE=10s
# Wrong guesses that end a verification code.
IDENTITY_CODE_ATTEMPTS=5
# How long after a verification code or a reset token was issued a request for another one answers as usual
# but issues and mails nothing.
IDENTITY_RESEND_COOLDOWN=60s
# From 10 to 14.
IDENTITY_BCRYPT_COST=12
# Failed sign-ins in a row that lock an account, and for how long.
IDENTITY_LOGIN_ATTEMPTS=5
IDENTITY_LOCKOUT=15m

# The comment module: the page size of a list that asks for none, and the most a list returns.
COMMENT_DEFAULT_PAGE_SIZE=20
COMMENT_MAX_PAGE_SIZE=100
